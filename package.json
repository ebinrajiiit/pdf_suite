{
  "name": "pdf-suite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @pdf-suite/web dev",
    "build": "pnpm -r --if-present build",
    "preview": "pnpm --filter @pdf-suite/web preview",
    "desktop": "pnpm --filter @pdf-suite/desktop tauri:dev",
    "desktop:build": "pnpm --filter @pdf-suite/desktop tauri:build",
    "desktop:info": "pnpm --filter @pdf-suite/desktop tauri:info",
    "test": "pnpm -r --if-present test",
    "e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:licenses": "node scripts/check-licenses.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "check:notices": "node scripts/third-party-notices.mjs --check",
    "corpus": "node scripts/corpus-runner.mjs",
    "corpus:samples": "node scripts/fetch-sample-corpus.mjs",
    "corpus:lsgkerala": "node scripts/fetch-lsgkerala.mjs",
    "bench:engines": "node scripts/bench-engines.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
